{
  "name": "youtube-downloader-desktop",
  "version": "5.0.0",
  "description": "Téléchargez et convertissez vos vidéos en MP4 simplement, sur Windows et macOS",
  "main": "electron/main.cjs",
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/raymondthibault88-ai/Youtube-Download.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && node electron/dev-runner.cjs",
    "prebuild": "node scripts/collect-licenses.cjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test tests/*.test.cjs",
    "test:smoke": "node scripts/smoke-test.cjs",
    "test:ui": "playwright test",
    "test:desktop": "node scripts/desktop-smoke.cjs",
    "test:conversion": "node scripts/benchmark-conversion.cjs",
    "test:download": "node scripts/benchmark-download.cjs",
    "setup:desktop": "node node_modules/electron/install.js",
    "verify": "npm run lint && npm run typecheck && npm test && npm run test:smoke && npm run build && npm run test:ui",
    "preview": "vite preview",
    "dist": "npm run verify && electron-builder --publish never",
    "dist:mac": "npm run verify && electron-builder --mac --publish never",
    "dist:win": "npm run verify && electron-builder --win --publish never"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^1.59.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electron/notarize": "^3.1.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "wait-on": "^9.1.0"
  },
  "overrides": {
    "flatted": "^3.4.2",
    "minimatch": "^3.1.5",
    "@electron/get": "^5.1.0"
  },
  "build": {
    "appId": "com.thibs.youtubedownloader",
    "productName": "YouTube Downloader",
    "publish": {
      "provider": "github",
      "owner": "raymondthibault88-ai",
      "repo": "Youtube-Download",
      "releaseType": "draft"
    },
    "electronUpdaterCompatibility": ">=6.8.9",
    "icon": "build/icons/icon.png",
    "files": [
      "dist/**/*",
      "electron/assets/**/*",
      "electron/ipc/**/*",
      "electron/services/**/*",
      "electron/main.cjs",
      "electron/preload.cjs",
      "electron/window.cjs",
      "electron/ytDlp.cjs",
      "shared/**/*",
      "THIRD_PARTY_NOTICES.md",
      "LICENSE",
      "licenses/**/*",
      "package.json"
    ],
    "electronLanguages": [
      "fr",
      "en-US"
    ],
    "npmRebuild": false,
    "afterSign": "electron/notarize.cjs",
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**"
    ],
    "mac": {
      "icon": "build/icons/icon.icns",
      "identity": "-",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "hardenedRuntime": true,
      "minimumSystemVersion": "13.0",
      "artifactName": "YouTube-Downloader-${version}-${arch}.${ext}"
    },
    "win": {
      "icon": "build/icons/icon.ico",
      "target": [
        "portable",
        "nsis"
      ],
      "artifactName": "YouTube-Downloader-${version}-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "YouTube-Downloader-Setup-${version}-${arch}.${ext}",
      "installerIcon": "build/icons/icon.ico",
      "uninstallerIcon": "build/icons/icon.ico",
      "installerHeaderIcon": "build/icons/icon.ico"
    },
    "portable": {
      "artifactName": "YouTube-Downloader-${version}-${arch}-portable.${ext}"
    },
    "directories": {
      "output": "release"
    }
  }
}
