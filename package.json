{
  "name": "youtube-downloader-desktop",
  "version": "1.0.0",
  "description": "Téléchargeur YouTube desktop (Windows/macOS) avec React + Electron",
  "main": "electron/main.cjs",
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && node electron/dev-runner.cjs",
    "build": "vite build",
    "lint": "eslint .",
    "test:smoke": "node scripts/smoke-test.cjs",
    "verify": "npm run lint && npm run test:smoke && npm run build",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.19.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2",
    "vite": "^8.0.2",
    "wait-on": "^9.0.4"
  },
  "overrides": {
    "flatted": "^3.4.2",
    "minimatch": "^3.1.5"
  },
  "build": {
    "appId": "com.thibs.youtubedownloader",
    "productName": "YouTube Downloader",
    "icon": "build/icons/icon.png",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**"
    ],
    "mac": {
      "icon": "build/icons/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities"
    },
    "win": {
      "icon": "build/icons/icon.ico",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "nsis": {
      "installerIcon": "build/icons/icon.ico",
      "uninstallerIcon": "build/icons/icon.ico",
      "installerHeaderIcon": "build/icons/icon.ico"
    },
    "directories": {
      "output": "release"
    }
  }
}
