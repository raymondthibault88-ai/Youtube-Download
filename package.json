{
  "name": "youtube-downloader-desktop",
  "version": "4.0.6",
  "description": "Téléchargeur et convertisseur vidéo MP4 performant pour Windows et macOS",
  "main": "electron/main.cjs",
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && node electron/dev-runner.cjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test tests/*.test.cjs",
    "test:smoke": "node scripts/smoke-test.cjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run test:smoke && npm run build",
    "preview": "vite preview",
    "dist": "npm run verify && electron-builder",
    "dist:mac": "npm run verify && electron-builder --mac",
    "verify:ffmpeg-win": "node scripts/verify-ffmpeg-win.cjs",
    "dist:win": "npm run verify && npm run verify:ffmpeg-win && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "wait-on": "^9.1.0"
  },
  "overrides": {
    "flatted": "^3.4.2",
    "minimatch": "^3.1.5"
  },
  "build": {
    "appId": "com.thibs.youtubedownloader",
    "productName": "YouTube Downloader",
    "icon": "build/icons/icon.png",
    "files": [
      "dist/**/*",
      "electron/assets/**/*",
      "electron/ipc/**/*",
      "electron/services/**/*",
      "electron/main.cjs",
      "electron/preload.cjs",
      "electron/window.cjs",
      "electron/ytDlp.cjs",
      "shared/**/*",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "electronLanguages": [
      "fr",
      "en-US"
    ],
    "npmRebuild": false,
    "afterSign": "electron/notarize.cjs",
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**"
    ],
    "mac": {
      "icon": "build/icons/icon.icns",
      "identity": "-",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "hardenedRuntime": true,
      "minimumSystemVersion": "13.0",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "win": {
      "icon": "build/icons/icon.ico",
      "target": [
        "portable",
        "nsis"
      ],
      "extraResources": [
        {
          "from": "build/ffmpeg/win32-x64",
          "to": "ffmpeg",
          "filter": [
            "ffmpeg.exe",
            "LICENSE.txt",
            "manifest.json"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "installerIcon": "build/icons/icon.ico",
      "uninstallerIcon": "build/icons/icon.ico",
      "installerHeaderIcon": "build/icons/icon.ico"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}-${arch}.${ext}"
    },
    "directories": {
      "output": "release"
    }
  }
}
