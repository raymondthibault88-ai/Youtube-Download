{
  "name": "youtube-downloader-desktop",
  "version": "4.0.9",
  "description": "Téléchargeur et convertisseur vidéo MP4 performant pour Windows et macOS",
  "main": "electron/main.cjs",
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "npm run prepare:ffmpeg",
    "prepare:ffmpeg": "node scripts/prepare-ffmpeg.cjs",
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && node electron/dev-runner.cjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test tests/*.test.cjs",
    "test:smoke": "node scripts/smoke-test.cjs",
    "test:e2e": "playwright test",
    "test:electron": "npm run build && node scripts/test-electron.cjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run test:smoke && npm run build",
    "preview": "vite preview",
    "dist": "npm run verify && npm run verify:ffmpeg && electron-builder",
    "dist:mac": "npm run verify && npm run verify:ffmpeg && electron-builder --mac",
    "verify:ffmpeg": "node scripts/verify-ffmpeg.cjs",
    "verify:ffmpeg-win": "node scripts/verify-ffmpeg-win.cjs",
    "dist:win": "npm run verify && npm run verify:ffmpeg-win && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "@electron-internal/extract-zip": "1.0.5",
    "@electron/notarize": "^3.1.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "electron": "^44.7.0",
    "electron-builder": "^26.17.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "ffmpeg-static": "^5.3.0",
    "globals": "^17.13.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1"
  },
  "overrides": {
    "flatted": "^3.4.2",
    "minimatch": "^3.1.5",
    "app-builder-lib": {
      "@electron/get": "^5.1.0"
    }
  },
  "build": {
    "appId": "com.thibs.youtubedownloader",
    "productName": "YouTube Downloader",
    "icon": "build/icons/icon.png",
    "files": [
      "dist/**/*",
      "electron/assets/**/*",
      "electron/ipc/**/*",
      "electron/services/**/*",
      "electron/main.cjs",
      "electron/preload.cjs",
      "electron/window.cjs",
      "electron/ytDlp.cjs",
      "shared/**/*",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "electronLanguages": [
      "fr",
      "en-US"
    ],
    "npmRebuild": false,
    "afterSign": "electron/notarize.cjs",
    "mac": {
      "icon": "build/icons/icon.icns",
      "identity": "-",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "hardenedRuntime": true,
      "minimumSystemVersion": "13.0",
      "extraResources": [
        {
          "from": "build/ffmpeg/darwin-${arch}",
          "to": "ffmpeg",
          "filter": [
            "ffmpeg",
            "LICENSE.txt",
            "manifest.json",
            "SOURCES.md"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "win": {
      "icon": "build/icons/icon.ico",
      "target": [
        "portable",
        "nsis"
      ],
      "extraResources": [
        {
          "from": "build/ffmpeg/win32-x64",
          "to": "ffmpeg",
          "filter": [
            "ffmpeg.exe",
            "LICENSE.txt",
            "manifest.json",
            "SOURCES.md",
            "BUILD_INFORMATION.txt"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "installerIcon": "build/icons/icon.ico",
      "uninstallerIcon": "build/icons/icon.ico",
      "installerHeaderIcon": "build/icons/icon.ico"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}-${arch}.${ext}"
    },
    "directories": {
      "output": "release"
    }
  }
}
